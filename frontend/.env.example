# Frontend environment (Vite). Copy to frontend/.env.local and fill in.
# These are PUBLIC values, safe in the browser bundle — RLS is what protects
# the data. The assignment spec names these NEXT_PUBLIC_*; this is a Vite app,
# so the equivalent prefix is VITE_.
#   NEXT_PUBLIC_NEON_AUTH_URL      -> VITE_NEON_AUTH_URL
#   NEXT_PUBLIC_NEON_DATA_API_URL  -> VITE_NEON_DATA_API_URL
VITE_NEON_AUTH_URL="https://ep-example-123456.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth"
VITE_NEON_DATA_API_URL="https://ep-example-123456.apirest.c-2.us-west-2.aws.neon.tech/neondb/rest/v1"

# Where the Node backend is running.
VITE_API_BASE_URL="http://localhost:8787"
