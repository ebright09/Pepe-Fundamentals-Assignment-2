# ==========================================================================
#  Secure Networking Tracker — environment variables
#  Copy to .env.local (frontend) and backend/.env  — NEVER commit real values.
# ==========================================================================

# --------------------------------------------------------------------------
# PUBLIC — safe to ship to the browser. These are HTTPS endpoints protected
# by Row Level Security; a leaked value cannot read another user's rows.
#
# This project is Vite + React (not Next.js), so the public prefix is VITE_
# rather than NEXT_PUBLIC_. The mapping to the names in the assignment spec:
#     NEXT_PUBLIC_NEON_AUTH_URL      ->  VITE_NEON_AUTH_URL
#     NEXT_PUBLIC_NEON_DATA_API_URL  ->  VITE_NEON_DATA_API_URL
# --------------------------------------------------------------------------
VITE_NEON_AUTH_URL="https://ep-example-123456.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth"
VITE_NEON_DATA_API_URL="https://ep-example-123456.apirest.c-2.us-west-2.aws.neon.tech/neondb/rest/v1"
VITE_API_BASE_URL="http://localhost:8787"

# --------------------------------------------------------------------------
# SERVER-ONLY — these must never appear in frontend code, in a VITE_/
# NEXT_PUBLIC_ variable, or in Git. Set them in backend/.env locally and in
# the Vercel dashboard for the backend project in production.
# --------------------------------------------------------------------------
NEON_AUTH_BASE_URL="https://ep-example-123456.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-example-123456.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth/jwks"
NEON_DATA_API_URL="https://ep-example-123456.apirest.c-2.us-west-2.aws.neon.tech/neondb/rest/v1"
ALLOWED_ORIGINS="http://localhost:5173"
PORT="8787"

# --------------------------------------------------------------------------
# MIGRATIONS ONLY — the raw Postgres connection string. The running
# application never uses this: all reads and writes go through the Neon Data
# API as the signed-in user so that RLS is always enforced. Used only to
# apply db/schema.sql, and you can avoid it entirely by pasting that file
# into the Neon SQL Editor instead.
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_AUTH_COOKIE_SECRET="replace-with-a-long-random-string"
